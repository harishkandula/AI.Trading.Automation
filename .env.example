# Application
APP_ENV=dev
LOG_LEVEL=INFO

# Database (PostgreSQL for production; sqlite:///./local.db for local dev)
DATABASE_URL=postgresql://user:password@localhost:5432/market_ai

# AWS
AWS_REGION=ap-south-1
MARKET_DATA_BUCKET=
STATE_TABLE=

# Groww API (obtain from https://groww.in/trade-api/docs)
GROWW_API_KEY=
GROWW_API_SECRET=
GROWW_TOTP_SECRET=
GROWW_ACCESS_TOKEN=

# Telegram (optional – platform works without this)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (optional – platform works without this)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Safety – must remain false in this release
ENABLE_LIVE_ORDERS=false

# Trading / portfolio defaults (override as needed)
RESEARCH_CAPITAL=5000000
RISK_PER_TRADE_PCT=0.005
MAX_OPEN_POSITIONS=10
MAX_NEW_POSITIONS_PER_SESSION=3
INTRADAY_CAPITAL=500000
INTRADAY_RISK_PER_TRADE_PCT=0.0025
INTRADAY_MAX_POSITIONS=3

# Broker (mock | groww)
BROKER_PROVIDER=mock
TRADING_MODE=RESEARCH_ONLY
